# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmarket?schema=public"
# For SQLite fallback (no Docker): DATABASE_URL="file:./dev.db"

# ─── Server ──────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── x402 Protocol Configuration ─────────────────────────────
X402_NETWORK=x402-local-sim
X402_FACILITATOR_URL=http://localhost:3001/api/v1/facilitator
X402_SCHEME=exact
X402_ASSET=USDC-SIM
X402_ASSET_DECIMALS=6
X402_VERSION=1

# ─── Simulated Wallet (DO NOT USE IN PRODUCTION) ─────────────
SIM_SIGNING_SECRET=agentmarket-dev-signing-secret-do-not-use-in-prod
SIM_INITIAL_BALANCE=100.000000

# ─── Budget Defaults (USD) ───────────────────────────────────
DEFAULT_DAILY_BUDGET=10.000000
DEFAULT_PER_REQUEST_LIMIT=1.000000
DEFAULT_PER_PROVIDER_LIMIT=5.000000

# ─── API Keys (seeded demo) ──────────────────────────────────
DEMO_AGENT_KEY=sk_agent_alpha_001
DEMO_PROVIDER_KEY=sk_provider_fastocr_001

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
